# Required: your Bowimi subdomain (e.g. "mycompany" for mycompany.bowimi.com)
BOWIMI_SUBDOMAIN=mycompany

# Auth option 1 — API key (recommended)
# Get yours from Bowimi → Integrations → Zapier → API Key
BOWIMI_API_KEY=yoursubdomain:yourapikey

# Auth option 2 — Email/password (alternative)
# BOWIMI_EMAIL=you@company.com
# BOWIMI_PASSWORD=yourpassword
